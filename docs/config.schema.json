    "EnsemblArchiveConfig": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "default": 50,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "connect_timeout_seconds": {
          "default": 30,
          "minimum": 1,
