    "FilteringConfig": {
      "additionalProperties": false,
      "properties": {
        "broad_disease_regex": {
          "default": [
            "^disease$",
            "^diseases$",
            "^cancer$",
            "^neoplasm$",
            "^neoplasms$",
            "^malignant neoplasm$",
            "^malignant neoplasms$",
            "^carcinoma$",
            "^tumor$",
            "^tumour$",
            "^genetic disease$",
            "^genetic disorder$"
          ],
          "items": {
            "type": "string"
          },
          "title": "Broad Disease Regex",
          "type": "array"
        },
        "drop_broad_disease_terms": {
          "default": true,
          "title": "Drop Broad Disease Terms",
          "type": "boolean"
        },
        "max_size_cancer": {
          "default": 500,
          "minimum": 1,
          "title": "Max Size Cancer",
          "type": "integer"
        },
        "max_size_default": {
          "default": 500,
          "minimum": 1,
          "title": "Max Size Default",
          "type": "integer"
